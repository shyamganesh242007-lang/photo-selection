# ==============================================================================
# PHOTO SELECTION PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE
# DO NOT COMMIT REAL CREDENTIALS TO VERSION CONTROL
# ==============================================================================

# Application Environment (development | production)
NODE_ENV=development
VITE_APP_NAME="ZeeBook Studio - Photo Selection Platform"
VITE_APP_URL="http://localhost:5173"
# Supabase Configuration (Use Project URL and Publishable Anon Key)
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-publishable-key-here"
# Cloudflare R2 Object Storage Configuration
# Cloudflare R2 is an S3-compatible object storage service with $0 egress fees.
CLOUDFLARE_R2_ACCOUNT_ID="your_cloudflare_account_id_here"
CLOUDFLARE_R2_ACCESS_KEY_ID="your_r2_access_key_id_here"
CLOUDFLARE_R2_SECRET_ACCESS_KEY="your_r2_secret_access_key_here"
CLOUDFLARE_R2_BUCKET_NAME="photographer-proofing-previews"
CLOUDFLARE_R2_PUBLIC_DOMAIN="https://previews.yourstudio.com"
CLOUDFLARE_R2_ENDPOINT="https://${CLOUDFLARE_R2_ACCOUNT_ID}.r2.cloudflarestorage.com"

# WebP Compression Defaults (Local Processing on Photographer's Machine)
VITE_WEBP_QUALITY=82
VITE_WEBP_MAX_WIDTH=1920
VITE_WEBP_MAX_HEIGHT=1280
VITE_TARGET_MAX_FILESIZE_KB=180

# Local Sync & Storage Settings
LOCAL_ORIGINALS_ROOT="D:\\Events"
LOCAL_EXPORT_PREFIX="Selected "
